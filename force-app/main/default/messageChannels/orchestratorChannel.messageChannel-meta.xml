<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Orchestrator Channel</masterLabel>
    <isExposed>true</isExposed>
    <description>Enterprise inter-component communication channel for Salesforce Orchestrator</description>
    <lightningMessageFields>
        <fieldName>actionType</fieldName>
        <description>The action type (e.g. FILTER_CHANGE, RECORD_SELECTED, BATCH_EXECUTE, REFRESH_DATA)</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>recordId</fieldName>
        <description>Optional target record ID</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>payload</fieldName>
        <description>JSON serialized or structured payload containing filter state or batch parameters</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>timestamp</fieldName>
        <description>Epoch timestamp of message dispatch</description>
    </lightningMessageFields>
</LightningMessageChannel>
